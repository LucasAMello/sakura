<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="Sakura2.0" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="Bin\Sakura2" prefix_auto="1" extension_auto="1" />
				<Option object_output="Obj\" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
				</Compiler>
				<Linker>
					<Add library="..\..\..\..\allegro\lib\liballeg.a" />
				</Linker>
			</Target>
			<Target title="Release">
				<Option output="bin\Release\Sakura2" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj\Release\" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-O2" />
				</Compiler>
				<Linker>
					<Add option="-s" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
			<Add option="-fexceptions -Wno-deprecated" />
		</Compiler>
		<Unit filename="Main.cpp" />
		<Unit filename="actor.cpp" />
		<Unit filename="actor.h" />
		<Unit filename="data.h" />
		<Unit filename="game.cpp" />
		<Unit filename="game.h" />
		<Unit filename="intro.cpp" />
		<Unit filename="intro.h" />
		<Unit filename="map.cpp" />
		<Unit filename="map.h" />
		<Unit filename="menu.cpp" />
		<Unit filename="menu.h" />
		<Unit filename="player.cpp" />
		<Unit filename="player.h" />
		<Unit filename="timing.h" />
		<Unit filename="wall.cpp" />
		<Unit filename="wall.h" />
		<Extensions>
			<code_completion />
			<debugger />
		</Extensions>
	</Project>
</CodeBlocks_project_file>
